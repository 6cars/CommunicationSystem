DEBUG=1
SECRET_KEY=dev-only-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 backend nginx 0.0.0.0

POSTGRES_DB=counseling
POSTGRES_USER=counseling
POSTGRES_PASSWORD=counseling
POSTGRES_HOST=db
POSTGRES_PORT=5432

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 経験想起支援機能 (LLM)
# OPENAI_API_KEY は秘密情報なのでこのファイルには書かず、リポジトリ直下の .env に書くか環境変数で渡す
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o